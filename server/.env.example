# Data Smith - environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Any value set in your shell environment takes precedence over this file.
# Optional machine-specific overrides go in `.env.local` (also gitignored).

# ---- Server ----
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=INFO

# ---- LLM provider: "ollama" or "gemini" ----
# Set in config.toml's [llm] section, or override here:
# LLM_PROVIDER=ollama

# ---- Ollama (local) ----
OLLAMA_MODEL=mistral:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# ---- Google Gemini ----
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=